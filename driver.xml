				<!--
					Every drill-down lands here, including from this screen itself. The
					browse tree is arbitrarily deep, so this screen recurses; screenDepth
					tells the Navigator how far in it is.
				-->
				<Screen xsi:type="ListScreenType">
					<Id>BrowseScreen</Id>
					<DataCommand>
						<Name>Browse</Name>
						<Type>PROTOCOL</Type>
						<Params>
							<Param><Name>screenId</Name><Type>SYSTEM</Type><Value>screenId</Value></Param>
							<Param><Name>tabId</Name><Type>SYSTEM</Type><Value>tabId</Value></Param>
